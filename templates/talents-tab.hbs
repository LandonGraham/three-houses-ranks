{{!-- tab.cssClass / tab.id / tab.group are supplied by the sheet. cssClass contains
      "active" for the selected tab, so it must be here or the tab disappears
      every time the sheet redraws (edit mode toggle, saving a change). --}}
<section class="tab thr-talents {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{!-- Header: the pool of XP points the player has not spent yet. --}}
  <header class="thr-header">
    <label for="thr-pool">{{localize "THR.Pool.Label"}}</label>
    {{!-- The pool can only be typed into while the sheet is in edit mode. --}}
    <input id="thr-pool" type="number" min="0" step="1" value="{{thr.pool}}"
           data-thr-field="pool" {{#unless thr.editMode}}disabled{{/unless}}>
  </header>

  {{!-- Column titles. Each row below uses the same 8 equal-width columns. --}}
  <div class="thr-columns thr-head-row">
    <span></span>
    <span>{{localize "THR.Column.Talent"}}</span>
    <span>{{localize "THR.Column.Trait"}}</span>
    <span>{{localize "THR.Column.Budding"}}</span>
    <span>{{localize "THR.Column.XP"}}</span>
    <span></span>
    <span></span>
    <span>{{localize "THR.Column.Rank"}}</span>
  </div>

  {{!-- One row per talent. Columns: talent icon, name, Strength/Weakness icon,
        Budding icon, XP, "+", rank icon, rank dropdown. --}}
  <ul class="thr-list">
    {{#each thr.rows as |row|}}
    <li class="thr-columns thr-row" data-talent-id="{{row.id}}">
      <img class="thr-icon" src="{{row.img}}" alt="{{row.name}}">
      <span class="thr-name">{{row.name}}</span>

      {{!-- Strength/Weakness icon. In edit mode, clicking it cycles the trait. --}}
      <button type="button" class="thr-slot" data-thr-action="cycle-trait"
              data-tooltip="{{row.traitLabel}}"
              {{#unless ../thr.editMode}}disabled{{/unless}}>
        {{#if row.traitImg}}<img class="thr-trait-img" src="{{row.traitImg}}" alt="{{row.traitLabel}}">{{/if}}
      </button>

      {{!-- Budding icon (4 steps). In edit mode, clicking it toggles Budding.
            A Strength can't be Budding, so that case is disabled. --}}
      <button type="button" class="thr-slot" data-thr-action="toggle-budding"
              data-tooltip="{{row.buddingTooltip}}"
              {{#if row.buddingDisabled}}disabled{{else}}{{#unless ../thr.editMode}}disabled{{/unless}}{{/if}}>
        {{#if row.buddingImg}}<img class="thr-budding-img" src="{{row.buddingImg}}" alt="{{localize 'THR.Budding.Label'}}">{{/if}}
      </button>

      {{!-- XP toward the next rank, e.g. "0/6". Promote shows when it is full. --}}
      <span class="thr-xp">
        {{#if row.atMax}}{{localize "THR.Rank.Max"}}{{else}}{{row.allocated}}/{{row.cost}}{{/if}}
        {{#if row.canPromote}}
        <button type="button" class="thr-btn thr-promote" data-thr-action="promote"
                data-tooltip="THR.Promote">
          <i class="fa-solid fa-arrow-up"></i>
        </button>
        {{/if}}
      </span>

      {{!-- "+" opens the allocation window. Available outside edit mode. --}}
      <button type="button" class="thr-btn" data-thr-action="allocate"
              data-tooltip="THR.Allocate.Button" {{#unless row.canAllocate}}disabled{{/unless}}>
        <i class="fa-solid fa-plus"></i>
      </button>

      <img class="thr-rank-img" src="{{row.rankImg}}" alt="{{row.rank}}">

      {{!-- Rank can only be changed directly in edit mode. --}}
      <select class="thr-rank" data-thr-field="rank" {{#unless ../thr.editMode}}disabled{{/unless}}>
        {{#each row.rankOptions as |opt|}}
        <option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
        {{/each}}
      </select>
    </li>
    {{/each}}
  </ul>
</section>
